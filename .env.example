PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_password
DB_NAME=baiao_db

# Alternativa às variáveis DB_* (provedores de hospedagem)
# DATABASE_URL=postgresql://user:password@host:5432/baiao_db
# Habilite quando o provedor exigir TLS com certificado confiável.
DB_SSL=false
# Origens de frontend permitidas, separadas por vírgula; vazio desabilita CORS.
CORS_ORIGIN=
